# Required - Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Required - Google Fact Check Explorer API Key
GOOGLE_FACT_CHECK_API_KEY=your_google_fact_check_key_here

# Optional - NewsAPI.org key (get free at newsapi.org — 100 req/day)
# Without this, the app uses built-in demo articles.
NEWS_API_KEY=your_newsapi_key_here

# Optional - GNews.io key (fallback if no NewsAPI key)
GNEWS_API_KEY=your_gnews_key_here
